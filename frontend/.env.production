# Build-time config for the /c/<token> private chat window.
#
# Committed on purpose. Every NEXT_PUBLIC_* value is compiled into the
# JavaScript the browser downloads, so these are public by definition —
# there is no secret here to leak, and committing them means a Vercel
# deploy works without anyone setting variables in a dashboard first.
#
# Vercel's own project environment variables still win over this file
# (they arrive as real process.env at build time), so overriding it later
# does not need a commit.

# The VOXO backend. Socket.IO shares this one listener with the REST API —
# see backend/src/server.ts, "REST and WebSocket traffic share one
# listener" — so there is no separate socket host, only the same origin
# without the /api suffix.
NEXT_PUBLIC_VOXO_API_URL=https://chatapp-0orj.onrender.com/api
NEXT_PUBLIC_VOXO_SOCKET_URL=https://chatapp-0orj.onrender.com

# Serve only /c/<token> from this deployment. The rest of the app — its own
# sign-in, registration, calls and status pages — is not what this URL is
# for, and has no backend configured here anyway. See src/middleware.ts.
NEXT_PUBLIC_GUEST_ONLY=true

# The public origin this build is served from. Only used to give Next an
# absolute base for metadata URLs — see metadataBase in src/app/layout.tsx.
NEXT_PUBLIC_SITE_URL=https://ctbabeindia.ai

# ── Background notifications (Firebase Cloud Messaging) ────────────────
#
# NOT set here, deliberately. Every value below is public — a Firebase web
# config is compiled into the page by design and the VAPID key is the
# PUBLIC half of the pair — so secrecy is not the reason. The reason is
# that they name one specific Firebase project, and a wrong value here
# fails in the worst possible way: the token request succeeds, the server
# accepts the token, and notifications simply never arrive, with no error
# anywhere to notice. An absent config is honest by comparison — the
# window then knows push is unavailable and never offers it.
#
# Set these five in the Vercel project's Environment Variables, from
# Firebase console → Project settings → General → Your apps → Web app,
# except the last, from Cloud Messaging → Web Push certificates:
#
#   NEXT_PUBLIC_FIREBASE_API_KEY
#   NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
#   NEXT_PUBLIC_FIREBASE_PROJECT_ID
#   NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
#   NEXT_PUBLIC_FIREBASE_APP_ID
#   NEXT_PUBLIC_FIREBASE_VAPID_KEY
#
# The backend needs FCM_SERVICE_ACCOUNT_JSON on Render, from the SAME
# Firebase project — a token minted by one project is rejected by another
# with SENDER_ID_MISMATCH.
