# Build-time config for the /c/<token> private chat window.
#
# Committed on purpose. Every NEXT_PUBLIC_* value is compiled into the
# JavaScript the browser downloads, so these are public by definition —
# there is no secret here to leak, and committing them means a Vercel
# deploy works without anyone setting variables in a dashboard first.
#
# Vercel's own project environment variables still win over this file
# (they arrive as real process.env at build time), so overriding it later
# does not need a commit.

# The VOXO backend. Socket.IO shares this one listener with the REST API —
# see backend/src/server.ts, "REST and WebSocket traffic share one
# listener" — so there is no separate socket host, only the same origin
# without the /api suffix.
NEXT_PUBLIC_VOXO_API_URL=https://chatapp-0orj.onrender.com/api
NEXT_PUBLIC_VOXO_SOCKET_URL=https://chatapp-0orj.onrender.com
